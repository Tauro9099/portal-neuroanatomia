---
import '../../styles/global.css';
---
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Simulador 3D Escala de Glasgow | NeuroLab UNAH-VS</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,600;0,700;1,400&family=JetBrains+Mono:wght@500;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <script is:inline src="https://cdn.tailwindcss.com"></script>
    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    
    <style>
      .font-editorial { font-family: 'Cormorant Garamond', Georgia, serif; }
      .font-cuerpo { font-family: 'Plus Jakarta Sans', sans-serif; }
      .font-tecnica { font-family: 'JetBrains Mono', monospace; }

      .bg-papel-ilustracion {
        background-color: #F6F2E9;
        background-image: radial-gradient(#D8D0C1 0.75px, transparent 0.75px);
        background-size: 18px 18px;
      }

      /* === ANIMACIÓN DE PANTALLA DE CARGA === */
      @keyframes barraCarga {
        0% { width: 0%; }
        100% { width: 100%; }
      }
      @keyframes desvanecerIntro {
        0%, 72% { opacity: 1; visibility: visible; }
        100% { opacity: 0; visibility: hidden; pointer-events: none; }
      }
      @keyframes pulsoLogo {
        0% { transform: scale(0.95); opacity: 0; }
        40% { transform: scale(1); opacity: 1; }
        100% { transform: scale(1); opacity: 1; }
      }
      .pantalla-intro {
        animation: desvanecerIntro 1.45s cubic-bezier(0.77, 0, 0.175, 1) forwards;
      }
      .logo-animado {
        animation: pulsoLogo 1.0s ease-out forwards;
      }
      .progreso-linea {
        animation: barraCarga 1.05s ease-in-out forwards;
      }

      /* === CONSOLA Y PALANCAS CON MOVIMIENTO 100% FLUIDO === */
      .fader-housing {
        background: linear-gradient(180deg, #F5EFE2 0%, #E6DEC8 100%);
        box-shadow: inset 0 1px 0 #FFFFFF, 0 2px 0 #2A324B;
      }
      .fader-track {
        touch-action: none;
        user-select: none;
        position: relative;
      }
      .fader-slot {
        width: 12px;
        height: 100%;
        background: linear-gradient(90deg, #0F1420 0%, #263044 50%, #0F1420 100%);
        border: 2px solid #1E2436;
        box-shadow: inset 0 4px 8px rgba(0,0,0,0.85), 1px 0 0 rgba(255,255,255,0.6);
        position: relative;
      }
      .fader-ticks {
        background-image: repeating-linear-gradient(
          to bottom,
          #647087 0px,
          #647087 2px,
          transparent 2px,
          transparent 12px
        );
      }

      /* Perilla física 3D con deslizamiento fluido */
      .fader-knob {
        cursor: grab;
        touch-action: none;
        user-select: none;
        width: 42px;
        height: 32px;
        left: 2px;
        transition: top 0.18s cubic-bezier(0.22, 1, 0.36, 1), transform 0.12s ease, box-shadow 0.15s ease;
        box-shadow: 
          0 6px 10px rgba(15, 20, 32, 0.45),
          0 2px 0 #1E2436,
          inset 0 2px 1px rgba(255, 255, 255, 0.55),
          inset 0 -3px 2px rgba(0, 0, 0, 0.35);
      }
      .fader-knob::before {
        content: '';
        position: absolute;
        inset: 4px 5px;
        border-top: 1px solid rgba(255,255,255,0.4);
        border-bottom: 1px solid rgba(0,0,0,0.3);
        pointer-events: none;
      }
      .fader-knob.knob-blue {
        background: linear-gradient(180deg, #60A5FA 0%, #2563EB 48%, #1D4ED8 52%, #1E40AF 100%);
      }
      .fader-knob.knob-orange {
        background: linear-gradient(180deg, #FBBF24 0%, #D97706 48%, #B45309 52%, #92400E 100%);
      }
      .fader-knob.knob-green {
        background: linear-gradient(180deg, #34D399 0%, #059669 48%, #047857 52%, #065F46 100%);
      }
      /* Movimiento libre y directo al arrastrar con el mouse */
      .fader-knob.dragging {
        cursor: grabbing;
        transition: none !important;
        transform: scale(1.06);
        box-shadow: 
          0 10px 16px rgba(15, 20, 32, 0.55),
          0 3px 0 #1E2436,
          inset 0 2px 1px rgba(255, 255, 255, 0.65);
      }

      .circulo-num {
        transition: all 0.18s cubic-bezier(0.22, 1, 0.36, 1);
        box-shadow: 0 2px 0 #1E2436;
      }
      .circulo-num:hover {
        transform: scale(1.12);
      }
    </style>
  </head>

  <body class="bg-papel-ilustracion text-[#1E2436] font-cuerpo min-h-screen flex flex-col justify-between selection:bg-[#0B1D3A] selection:text-white">

    <!-- ==========================================
         PANTALLA DE CARGA ANIMADA (INTRO NEUROLAB)
         ========================================== -->
    <div class="pantalla-intro fixed inset-0 z-50 bg-[#0B1D3A] flex flex-col items-center justify-center p-6 border-8 border-[#141413]">
      <div class="logo-animado flex flex-col items-center max-w-md w-full text-center">
        <img 
          src="/logo-neurolab.png" 
          alt="Logo NeuroLab" 
          class="h-28 md:h-36 w-auto object-contain mb-5"
          onerror="this.style.display='none'" 
        />
        <h2 class="font-editorial text-3xl md:text-4xl text-[#FAF8F5] font-bold tracking-wide mb-1">
          NEUROLAB
        </h2>
        <p class="font-tecnica text-[11px] uppercase tracking-[0.25em] text-[#D4AF37] mb-5">
          Laboratorio de Neuroanatomía // UNAH-VS
        </p>
        <div class="w-60 h-[2px] bg-[#FAF8F5]/20 overflow-hidden">
          <div class="progreso-linea h-full bg-[#D4AF37]"></div>
        </div>
        <span class="font-tecnica text-[10px] text-[#FAF8F5]/60 uppercase tracking-widest mt-3">
          Inicializando Simulador 3D: Escala de Glasgow...
        </span>
      </div>
    </div>

    <!-- ==========================================
         SECCIÓN 1: CABECERA COMPACTA NEUROLAB
         ========================================== -->
    <header class="border-b-2 border-[#1E2436] bg-[#0B1D3A] text-[#FAF8F5]">
      <div class="max-w-7xl mx-auto px-6 py-3 flex flex-wrap justify-between items-center gap-4">
        <div class="flex items-center gap-4">
          <a href="/" class="border border-[#D4AF37] bg-[#071326] hover:bg-[#D4AF37] hover:text-[#141413] px-3.5 py-1.5 font-tecnica text-xs uppercase tracking-widest font-bold transition-colors">
            ← Volver al Menú Principal
          </a>
          <span class="font-tecnica text-xs text-[#D4AF37] uppercase tracking-widest hidden sm:inline">
            // NeuroLab UNAH-VS • Simulación Clínica 3D
          </span>
        </div>
        <button id="btn-test-audio" type="button" class="border border-[#D4AF37]/60 bg-[#071326] hover:bg-[#D4AF37] hover:text-[#141413] px-3 py-1 font-tecnica text-[11px] text-[#D4AF37] font-bold uppercase tracking-wider cursor-pointer transition-colors">
          🔊 Sonido Suave: ACTIVO
        </button>
      </div>
    </header>

    <main class="max-w-7xl mx-auto w-full px-4 sm:px-6 py-6 flex-1">

      <!-- ==========================================
           SECCIÓN 2: INTRODUCCIÓN VISUAL + FOTO DE LOS CREADORES
           ========================================== -->
      <section class="mb-8 border-2 border-[#1E2436] bg-[#FAF8F5] p-5 sm:p-6 shadow-[5px_5px_0px_#1E2436]">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-center">
          
          <!-- Fotografía Histórica de Bryan Jennett y Graham Teasdale -->
          <div class="lg:col-span-4 flex flex-col sm:flex-row lg:flex-col items-center gap-4 border-b lg:border-b-0 lg:border-r-2 border-[#1E2436]/20 pb-4 lg:pb-0 lg:pr-6">
            <div class="border-2 border-[#1E2436] bg-white p-2 shadow-[3px_3px_0px_#0B1D3A] w-44 sm:w-48 shrink-0">
              <img 
                src="/graham-bryan.jpg" 
                alt="Bryan Jennett y Graham Teasdale" 
                class="w-full h-44 object-cover object-top border border-[#1E2436]"
                onerror="this.src='https://placehold.co/300x320/0B1D3A/D4AF37?text=Coloca+graham-bryan.jpg\\nen+carpeta+public'"
              />
              <p class="font-tecnica text-[10px] text-center text-[#1E2436] font-bold mt-1.5 leading-tight">
                B. JENNETT & G. TEASDALE (1974)
              </p>
            </div>
            <div class="text-center sm:text-left lg:text-center">
              <span class="bg-[#0B1D3A] text-[#D4AF37] font-tecnica text-[10px] uppercase tracking-widest px-2 py-0.5 font-bold">
                Universidad de Glasgow, Escocia
              </span>
              <p class="text-xs text-neutral-600 mt-1.5 leading-snug">
                Publicada en <em>The Lancet</em> (1974) por los neurocirujanos <strong>Graham Teasdale y Bryan Jennett</strong> para estandarizar mundialmente la evaluación del coma.
              </p>
            </div>
          </div>

          <!-- Bloques Visuales Rápidos -->
          <div class="lg:col-span-8 space-y-4">
            <div>
              <span class="font-tecnica text-xs uppercase tracking-widest text-[#B8860B] font-bold">
                Evaluación Neurológica Estandarizada
              </span>
              <h1 class="font-editorial text-3xl sm:text-4xl font-bold text-[#0B1D3A] leading-none mt-0.5">
                Escala de Coma de Glasgow (GCS)
              </h1>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
              <div class="border-2 border-[#1E2436] bg-white p-3">
                <div class="font-tecnica text-xs font-extrabold text-[#2B6CB0] uppercase mb-1">01. ¿Qué evalúa?</div>
                <p class="text-xs text-neutral-700 leading-relaxed">
                  Mide la integridad del <strong>SRAA (Tronco Encefálico)</strong> y la <strong>Corteza Cerebral</strong> mediante 3 respuestas: Ocular, Verbal y Motora.
                </p>
              </div>
              <div class="border-2 border-[#1E2436] bg-white p-3">
                <div class="font-tecnica text-xs font-extrabold text-[#D97706] uppercase mb-1">02. Rango (3 a 15 pts)</div>
                <p class="text-xs text-neutral-700 leading-relaxed">
                  <strong>15 pts:</strong> Consciente y alerta.<br/>
                  <strong>9–12 pts:</strong> Daño moderado.<br/>
                  <strong>3 pts:</strong> Coma profundo (mínimo).
                </p>
              </div>
              <div class="border-2 border-[#1E2436] bg-red-50 p-3">
                <div class="font-tecnica text-xs font-extrabold text-red-700 uppercase mb-1">03. Regla de Oro Clínica</div>
                <p class="text-xs text-neutral-800 leading-relaxed">
                  Todo paciente con <strong>Glasgow ≤ 8 puntos</strong> pierde reflejos protectores de la vía aérea y requiere <strong>intubación endotraqueal</strong>.
                </p>
              </div>
            </div>
          </div>

        </div>
      </section>

      <!-- ==========================================
           SECCIÓN 3: MARCADOR SUPERIOR DE PUNTAJE
           ========================================== -->
      <section class="mb-5 text-center">
        <div class="inline-flex flex-wrap justify-center gap-2 sm:gap-3 mb-2">
          <div class="flex items-baseline justify-between gap-4 bg-[#FAF8F5] border-2 border-[#2A324B] border-l-[7px] border-l-[#2B6CB0] px-4 py-1.5 min-w-[130px] shadow-[2px_2px_0px_#2A324B]">
            <span class="font-tecnica text-xs font-extrabold tracking-wider text-[#2B6CB0]">OCULAR</span>
            <span class="font-tecnica text-xl font-extrabold text-[#1E2436]"><strong id="top-e">4</strong><small class="text-xs text-neutral-400">/4</small></span>
          </div>

          <div class="flex items-baseline justify-between gap-4 bg-[#FAF8F5] border-2 border-[#2A324B] border-l-[7px] border-l-[#D97706] px-4 py-1.5 min-w-[130px] shadow-[2px_2px_0px_#2A324B]">
            <span class="font-tecnica text-xs font-extrabold tracking-wider text-[#D97706]">VERBAL</span>
            <span class="font-tecnica text-xl font-extrabold text-[#1E2436]"><strong id="top-v">5</strong><small class="text-xs text-neutral-400">/5</small></span>
          </div>

          <div class="flex items-baseline justify-between gap-4 bg-[#FAF8F5] border-2 border-[#2A324B] border-l-[7px] border-l-[#2F855A] px-4 py-1.5 min-w-[130px] shadow-[2px_2px_0px_#2A324B]">
            <span class="font-tecnica text-xs font-extrabold tracking-wider text-[#2F855A]">MOTOR</span>
            <span class="font-tecnica text-xl font-extrabold text-[#1E2436]"><strong id="top-m">6</strong><small class="text-xs text-neutral-400">/6</small></span>
          </div>

          <div class="flex items-baseline justify-between gap-4 bg-[#FAF8F5] border-2 border-[#2A324B] border-l-[7px] border-l-[#5B21B6] px-4 py-1.5 min-w-[125px] shadow-[2px_2px_0px_#2A324B]">
            <span class="font-tecnica text-xs font-extrabold tracking-wider text-[#5B21B6]">GCS</span>
            <span id="top-total" class="font-tecnica text-2xl font-extrabold text-[#1E2436]">15</span>
          </div>
        </div>

        <h2 id="subtitulo-resumen" class="font-tecnica text-lg sm:text-xl font-extrabold tracking-wide text-[#2A324B]">
          OCULAR 4 · VERBAL 5 · MOTOR 6
        </h2>
      </section>

      <!-- ==========================================
           SECCIÓN 4: CONSOLA DE PALANCAS 3D + VISOR DE PERSONAJE 3D
           ========================================== -->
      <section class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-stretch">

        <!-- COLUMNA IZQUIERDA (5 COLS): CONSOLA FÍSICA CON PALANCAS FLUIDAS -->
        <div class="lg:col-span-5 bg-[#5B6475] border-2 border-[#2A324B] p-4 sm:p-5 shadow-[6px_6px_0px_#2A324B] flex flex-col justify-between">
          
          <div class="bg-[#EAE2D0] border-2 border-[#2A324B] p-4 sm:p-5 relative flex-1 flex flex-col justify-between shadow-inner">
            <!-- 4 Tornillos en las esquinas -->
            <span class="w-3 h-3 rounded-full border-2 border-[#2A324B] bg-[#D5CBB8] absolute top-2.5 left-2.5"></span>
            <span class="w-3 h-3 rounded-full border-2 border-[#2A324B] bg-[#D5CBB8] absolute top-2.5 right-2.5"></span>
            <span class="w-3 h-3 rounded-full border-2 border-[#2A324B] bg-[#D5CBB8] absolute bottom-2.5 left-2.5"></span>
            <span class="w-3 h-3 rounded-full border-2 border-[#2A324B] bg-[#D5CBB8] absolute bottom-2.5 right-2.5"></span>

            <div class="text-center mb-2">
              <span class="font-tecnica text-[11px] font-bold uppercase tracking-widest text-[#2A324B]">
                🎛️ Desliza las palancas físicas hacia arriba o abajo
              </span>
            </div>

            <!-- 3 Módulos de Palancas Hardware + Pantalla GCS -->
            <div class="grid grid-cols-4 gap-2 sm:gap-2.5 items-end my-auto pt-2 pb-4">

              <!-- PALANCA 1: OCULAR (1-4) -->
              <div class="fader-housing border-2 border-[#2A324B] p-2 flex flex-col items-center h-[295px] justify-between relative">
                <div class="w-full bg-[#2563EB] text-white font-tecnica text-[10px] font-extrabold text-center py-1 border border-[#1E2436]">
                  OCULAR
                </div>
                
                <div id="track-E" data-group="E" data-min="1" data-max="4" class="fader-track flex-1 w-full flex justify-between items-center px-1 my-2.5 cursor-pointer">
                  <div class="relative left-[14px] h-full flex items-center">
                    <div class="fader-ticks w-6 h-[92%] absolute -left-1.5 opacity-70"></div>
                    <div class="fader-slot"></div>
                  </div>

                  <div id="knob-E" data-group="E" style="top: 4%;" class="fader-knob knob-blue absolute border-2 border-[#141824] flex flex-col items-center justify-center z-20">
                    <div class="w-6 h-[2px] bg-white shadow-[0_1px_2px_rgba(0,0,0,0.8)]"></div>
                  </div>

                  <div class="flex flex-col justify-between h-full py-1 z-10 ml-auto">
                    <button data-group="E" data-val="4" class="slider-btn circulo-num w-7 h-7 rounded-full border-2 border-[#2A324B] font-tecnica text-xs font-extrabold flex items-center justify-center cursor-pointer">4</button>
                    <button data-group="E" data-val="3" class="slider-btn circulo-num w-7 h-7 rounded-full border-2 border-[#2A324B] font-tecnica text-xs font-extrabold flex items-center justify-center cursor-pointer">3</button>
                    <button data-group="E" data-val="2" class="slider-btn circulo-num w-7 h-7 rounded-full border-2 border-[#2A324B] font-tecnica text-xs font-extrabold flex items-center justify-center cursor-pointer">2</button>
                    <button data-group="E" data-val="1" class="slider-btn circulo-num w-7 h-7 rounded-full border-2 border-[#2A324B] font-tecnica text-xs font-extrabold flex items-center justify-center cursor-pointer">1</button>
                  </div>
                </div>
              </div>

              <!-- PALANCA 2: VERBAL (1-5) -->
              <div class="fader-housing border-2 border-[#2A324B] p-2 flex flex-col items-center h-[345px] justify-between relative">
                <div class="w-full bg-[#D97706] text-white font-tecnica text-[10px] font-extrabold text-center py-1 border border-[#1E2436]">
                  VERBAL
                </div>
                
                <div id="track-V" data-group="V" data-min="1" data-max="5" class="fader-track flex-1 w-full flex justify-between items-center px-1 my-2.5 cursor-pointer">
                  <div class="relative left-[14px] h-full flex items-center">
                    <div class="fader-ticks w-6 h-[92%] absolute -left-1.5 opacity-70"></div>
                    <div class="fader-slot"></div>
                  </div>

                  <div id="knob-V" data-group="V" style="top: 3%;" class="fader-knob knob-orange absolute border-2 border-[#141824] flex flex-col items-center justify-center z-20">
                    <div class="w-6 h-[2px] bg-[#141824] shadow-[0_1px_0_rgba(255,255,255,0.5)]"></div>
                  </div>

                  <div class="flex flex-col justify-between h-full py-1 z-10 ml-auto">
                    <button data-group="V" data-val="5" class="slider-btn circulo-num w-7 h-7 rounded-full border-2 border-[#2A324B] font-tecnica text-xs font-extrabold flex items-center justify-center cursor-pointer">5</button>
                    <button data-group="V" data-val="4" class="slider-btn circulo-num w-7 h-7 rounded-full border-2 border-[#2A324B] font-tecnica text-xs font-extrabold flex items-center justify-center cursor-pointer">4</button>
                    <button data-group="V" data-val="3" class="slider-btn circulo-num w-7 h-7 rounded-full border-2 border-[#2A324B] font-tecnica text-xs font-extrabold flex items-center justify-center cursor-pointer">3</button>
                    <button data-group="V" data-val="2" class="slider-btn circulo-num w-7 h-7 rounded-full border-2 border-[#2A324B] font-tecnica text-xs font-extrabold flex items-center justify-center cursor-pointer">2</button>
                    <button data-group="V" data-val="1" class="slider-btn circulo-num w-7 h-7 rounded-full border-2 border-[#2A324B] font-tecnica text-xs font-extrabold flex items-center justify-center cursor-pointer">1</button>
                  </div>
                </div>
              </div>

              <!-- PALANCA 3: MOTOR (1-6) -->
              <div class="fader-housing border-2 border-[#2A324B] p-2 flex flex-col items-center h-[395px] justify-between relative">
                <div class="w-full bg-[#059669] text-white font-tecnica text-[10px] font-extrabold text-center py-1 border border-[#1E2436]">
                  MOTOR
                </div>
                
                <div id="track-M" data-group="M" data-min="1" data-max="6" class="fader-track flex-1 w-full flex justify-between items-center px-1 my-2.5 cursor-pointer">
                  <div class="relative left-[14px] h-full flex items-center">
                    <div class="fader-ticks w-6 h-[92%] absolute -left-1.5 opacity-70"></div>
                    <div class="fader-slot"></div>
                  </div>

                  <div id="knob-M" data-group="M" style="top: 2%;" class="fader-knob knob-green absolute border-2 border-[#141824] flex flex-col items-center justify-center z-20">
                    <div class="w-6 h-[2px] bg-white shadow-[0_1px_2px_rgba(0,0,0,0.8)]"></div>
                  </div>

                  <div class="flex flex-col justify-between h-full py-1 z-10 ml-auto">
                    <button data-group="M" data-val="6" class="slider-btn circulo-num w-7 h-7 rounded-full border-2 border-[#2A324B] font-tecnica text-xs font-extrabold flex items-center justify-center cursor-pointer">6</button>
                    <button data-group="M" data-val="5" class="slider-btn circulo-num w-7 h-7 rounded-full border-2 border-[#2A324B] font-tecnica text-xs font-extrabold flex items-center justify-center cursor-pointer">5</button>
                    <button data-group="M" data-val="4" class="slider-btn circulo-num w-7 h-7 rounded-full border-2 border-[#2A324B] font-tecnica text-xs font-extrabold flex items-center justify-center cursor-pointer">4</button>
                    <button data-group="M" data-val="3" class="slider-btn circulo-num w-7 h-7 rounded-full border-2 border-[#2A324B] font-tecnica text-xs font-extrabold flex items-center justify-center cursor-pointer">3</button>
                    <button data-group="M" data-val="2" class="slider-btn circulo-num w-7 h-7 rounded-full border-2 border-[#2A324B] font-tecnica text-xs font-extrabold flex items-center justify-center cursor-pointer">2</button>
                    <button data-group="M" data-val="1" class="slider-btn circulo-num w-7 h-7 rounded-full border-2 border-[#2A324B] font-tecnica text-xs font-extrabold flex items-center justify-center cursor-pointer">1</button>
                  </div>
                </div>
              </div>

              <!-- PANTALLA LUMINOSA GCS -->
              <div class="flex flex-col justify-center h-[395px]">
                <div class="fader-housing border-2 border-[#2A324B] p-2.5 text-center shadow-[3px_3px_0px_#2A324B]">
                  <span class="font-tecnica text-xs font-extrabold text-[#2A324B] block mb-1">GCS</span>
                  <div class="bg-[#0D1F17] border-2 border-[#1E2436] py-4 px-1 flex items-center justify-center shadow-inner">
                    <span id="pantalla-verde-gcs" class="font-tecnica text-3xl sm:text-4xl font-extrabold text-[#4ADE80] drop-shadow-[0_0_10px_rgba(74,222,128,0.85)]">
                      15
                    </span>
                  </div>
