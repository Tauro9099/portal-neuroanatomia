    <!-- ==========================================================
         SCRIPT COMPLETO: SONIDO SUTIL + PALANCAS FLUIDAS + 3D
         ========================================================== -->
    <script is:inline>
      const state = { E: 4, V: 5, M: 6 };
      let ultimoModificado = 'E';
      let sonidoHabilitado = true;

      const posOcular = { 4: 4, 3: 32, 2: 60, 1: 86 };
      const posVerbal = { 5: 3, 4: 25, 3: 47, 2: 68, 1: 88 };
      const posMotor  = { 6: 2, 5: 19, 4: 37, 3: 55, 2: 72, 1: 89 };

      const infoE = {
        4: { tit: "ESPONTÁNEA", sub: "Abre los ojos por sí sola, parpadea y fija la mirada." },
        3: { tit: "AL SONIDO (AL LLAMADO)", sub: "Ojos cerrados en reposo; los abre al hablarle en voz alta." },
        2: { tit: "A LA PRESIÓN (AL DOLOR)", sub: "Solo entreabre los ojos y frunce el ceño ante presión ungueal." },
        1: { tit: "NINGUNA RESPUESTA", sub: "Párpados completamente cerrados sin respuesta al dolor." }
      };

      const infoV = {
        5: { tit: "ORIENTADA", sub: "Consciente de su nombre, ubicación y fecha.", frase: '"Hola doctor, me llamo Elena. Estoy en el hospital de San Pedro Sula."' },
        4: { tit: "CONFUSA", sub: "Habla con frases completas pero está desorientada.", frase: '"¿Dónde estoy?... ¿Qué hago aquí? Quiero irme a mi casa."' },
        3: { tit: "PALABRAS SUELTAS", sub: "Palabras inteligibles pero sin conexión.", frase: '"¡Puerta!... ¡Frío ayer!... ¡Llaves!" (Palabras incoherentes)' },
        2: { tit: "SONIDOS INCOMPRENSIBLES", sub: "Quejidos o gemidos guturales sin articular palabras.", frase: '"Uhhhh... mmmghhh... aahhh..." (Quejidos al dolor)' },
        1: { tit: "NINGUNA RESPUESTA", sub: "Ausencia total de fonación.", frase: '[ Silencio clínico — Paciente intubada si GCS ≤ 8 ]' }
      };

      const infoM = {
        6: { tit: "OBEDECE ÓRDENES", sub: "Levanta la mano y mueve los dedos voluntariamente al pedírselo." },
        5: { tit: "LOCALIZA EL DOLOR", sub: "Cruza su mano intencionalmente hacia el punto de estímulo doloroso." },
        4: { tit: "FLEXIÓN NORMAL (RETIRADA)", sub: "Retira y flexiona el brazo rápidamente alejándose del bolígrafo." },
        3: { tit: "DECORTICACIÓN (FLEXIÓN)", sub: "Flexión rígida de codos, muñecas y dedos sobre el pecho (Lesión sobre el Núcleo Rojo)." },
        2: { tit: "DESCEREBRACIÓN (EXTENSIÓN)", sub: "Extensión rígida y pronación hacia afuera (Lesión de tronco bajo el Núcleo Rojo)." },
        1: { tit: "NINGUNA (FLACIDEZ)", sub: "Atonía muscular completa; extremidades relajadas sin respuesta." }
      };

      // ==========================================================
      // 1. CLIC ACÚSTICO SUAVE Y DISCRETO (SOLO AL ENCAJAR EN UN NÚMERO)
      // ==========================================================
      let audioCtx = null;

      function desbloquearAudio() {
        const AudioContextClass = window.AudioContext || window.webkitAudioContext;
        if (!AudioContextClass) return null;
        if (!audioCtx) {
          audioCtx = new AudioContextClass();
        }
        if (audioCtx.state === 'suspended') {
          audioCtx.resume();
        }
        return audioCtx;
      }

      window.addEventListener('pointerdown', desbloquearAudio, { passive: true });

      function sonarEncajeSuave(nivel = 3) {
        if (!sonidoHabilitado) return;
        const ctx = desbloquearAudio();
        if (!ctx) return;

        const now = ctx.currentTime;
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();

        // Onda sinusoidal pura y corta (suave como un clic táctil de reloj/perilla fina)
        osc.type = 'sine';
        const freq = 240 + (nivel * 18);
        osc.frequency.setValueAtTime(freq, now);
        osc.frequency.exponentialRampToValueAtTime(95, now + 0.022);

        // Volumen bajo y agradable (0.06)
        gain.gain.setValueAtTime(0.06, now);
        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.022);

        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start(now);
        osc.stop(now + 0.025);
      }

      document.getElementById('btn-test-audio').addEventListener('click', (e) => {
        sonidoHabilitado = !sonidoHabilitado;
        if (sonidoHabilitado) {
          e.currentTarget.textContent = "🔊 Sonido Suave: ACTIVO";
          sonarEncajeSuave(4);
        } else {
          e.currentTarget.textContent = "🔇 Sonido: SILENCIADO";
        }
      });

      // ==========================================================
      // 2. CONFIGURACIÓN DEL ESTUDIO 3D (THREE.JS)
      // ==========================================================
      const container = document.getElementById('contenedor-3d');
      const scene = new THREE.Scene();

      const camera = new THREE.PerspectiveCamera(34, container.clientWidth / container.clientHeight, 0.1, 100);
      const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
      renderer.setSize(container.clientWidth, container.clientHeight);
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
      renderer.shadowMap.enabled = true;
      renderer.shadowMap.type = THREE.PCFSoftShadowMap;
      renderer.toneMapping = THREE.ACESFilmicToneMapping;
      renderer.toneMappingExposure = 1.08;
      renderer.outputEncoding = THREE.sRGBEncoding;
      container.appendChild(renderer.domElement);

      const hemiLight = new THREE.HemisphereLight(0xfff8f0, 0x64748b, 0.85);
      hemiLight.position.set(0, 8, 0);
      scene.add(hemiLight);

      const keyLight = new THREE.DirectionalLight(0xfffaf0, 1.15);
      keyLight.position.set(3.5, 5.5, 5.0);
      keyLight.castShadow = true;
      keyLight.shadow.mapSize.width = 1024;
      keyLight.shadow.mapSize.height = 1024;
      scene.add(keyLight);

      const fillLight = new THREE.DirectionalLight(0xe0f2fe, 0.55);
      fillLight.position.set(-4.0, 2.5, 3.0);
      scene.add(fillLight);

      const rimLight = new THREE.DirectionalLight(0xffffff, 0.45);
      rimLight.position.set(0, 4.0, -4.0);
      scene.add(rimLight);

      const matSkin = new THREE.MeshPhysicalMaterial({ color: 0xF3B792, roughness: 0.56, clearcoat: 0.06 });
      const matBlush = new THREE.MeshPhysicalMaterial({ color: 0xE58572, roughness: 0.6, transparent: true, opacity: 0.45 });
      const matNails = new THREE.MeshPhysicalMaterial({ color: 0xF9D5C2, roughness: 0.3, clearcoat: 0.3 });
      const matHair = new THREE.MeshPhysicalMaterial({ color: 0xE87A24, roughness: 0.45, clearcoat: 0.12 });
      const matShirt = new THREE.MeshPhysicalMaterial({ color: 0xF2C14E, roughness: 0.68 });
      const matPants = new THREE.MeshPhysicalMaterial({ color: 0x4E8098, roughness: 0.65 });
      const matEyeDark = new THREE.MeshPhysicalMaterial({ color: 0x1A1817, roughness: 0.08, clearcoat: 1.0 });
      const matEyeHighlight = new THREE.MeshBasicMaterial({ color: 0xFFFFFF });
      const matMouth = new THREE.MeshStandardMaterial({ color: 0x3D2622, roughness: 0.5 });
      const matPillow = new THREE.MeshPhysicalMaterial({ color: 0xFAF8F5, roughness: 0.75 });
      const matBed = new THREE.MeshPhysicalMaterial({ color: 0xE2E8F0, roughness: 0.8 });
      const matDocSleeve = new THREE.MeshPhysicalMaterial({ color: 0x5B7083, roughness: 0.6 });
      const matPenBody = new THREE.MeshStandardMaterial({ color: 0x1E293B, roughness: 0.25, metalness: 0.7 });
      const matPenTip = new THREE.MeshStandardMaterial({ color: 0xCBD5E1, roughness: 0.2, metalness: 0.9 });

      function createSmoothCapsule(rTop, rBot, len, mat, segs = 24) {
        const group = new THREE.Group();
        const cyl = new THREE.Mesh(new THREE.CylinderGeometry(rTop, rBot, len, segs), mat);
        cyl.castShadow = true;
        cyl.receiveShadow = true;
        const topCap = new THREE.Mesh(new THREE.SphereGeometry(rTop, segs, 16), mat);
        topCap.position.y = len / 2;
        const botCap = new THREE.Mesh(new THREE.SphereGeometry(rBot, segs, 16), mat);
        botCap.position.y = -len / 2;
        group.add(cyl, topCap, botCap);
        return group;
      }

      // Cama y Almohada
      const envGroup = new THREE.Group();
      scene.add(envGroup);

      const mattress = new THREE.Mesh(new THREE.BoxGeometry(3.5, 2.8, 0.35), matBed);
      mattress.position.set(0, 0.2, -0.72);
      mattress.receiveShadow = true;
      envGroup.add(mattress);

      const pillowGeo = new THREE.SphereGeometry(1.05, 40, 32);
      pillowGeo.scale(1.32, 0.68, 0.34);
      const pillow = new THREE.Mesh(pillowGeo, matPillow);
      pillow.position.set(0, 1.05, -0.38);
      pillow.receiveShadow = true;
      envGroup.add(pillow);

      const blanketGeo = new THREE.CylinderGeometry(0.76, 0.82, 1.2, 32);
      blanketGeo.scale(1.25, 1.0, 0.68);
      const blanket = new THREE.Mesh(blanketGeo, matPants);
      blanket.position.set(0, -1.05, 0.08);
      envGroup.add(blanket);

      // Paciente 3D
      const patientRoot = new THREE.Group();
      patientRoot.position.set(0, -0.05, 0);
      scene.add(patientRoot);

      const torsoGroup = new THREE.Group();
      patientRoot.add(torsoGroup);

      const torsoGeo = new THREE.CylinderGeometry(0.48, 0.44, 1.05, 32);
      torsoGeo.scale(1.22, 1.0, 0.72);
      const torsoMesh = new THREE.Mesh(torsoGeo, matShirt);
      torsoMesh.position.set(0, 0.02, 0);
      torsoMesh.castShadow = true;
      torsoGroup.add(torsoMesh);

      const upperChestGeo = new THREE.SphereGeometry(0.52, 32, 24);
      upperChestGeo.scale(1.18, 0.55, 0.68);
      const upperChest = new THREE.Mesh(upperChestGeo, matShirt);
      upperChest.position.set(0, 0.46, 0);
      torsoGroup.add(upperChest);

      const neckCyl = new THREE.Mesh(new THREE.CylinderGeometry(0.165, 0.19, 0.36, 24), matSkin);
      neckCyl.position.set(0, 0.82, 0.04);
      torsoGroup.add(neckCyl);

      const headGroup = new THREE.Group();
      headGroup.position.set(0, 1.24, 0.12);
      torsoGroup.add(headGroup);

      const headGeo = new THREE.SphereGeometry(0.43, 48, 48);
      const posAttr = headGeo.attributes.position;
      const v = new THREE.Vector3();
      for (let i = 0; i < posAttr.count; i++) {
        v.fromBufferAttribute(posAttr, i);
        const yNorm = v.y / 0.43;
        if (yNorm < 0) {
          v.x *= 1.0 + Math.sin(Math.abs(yNorm) * Math.PI * 0.65) * 0.09;
          v.y *= 0.94;
        } else {
          v.x *= 1.03;
        }
        if (v.z > 0) v.z *= 0.92;
        posAttr.setXYZ(i, v.x, v.y, v.z);
      }
      headGeo.computeVertexNormals();

      const headMesh = new THREE.Mesh(headGeo, matSkin);
      headMesh.castShadow = true;
      headGroup.add(headMesh);

      const blushGeo = new THREE.SphereGeometry(0.085, 20, 16);
      blushGeo.scale(1.2, 0.75, 0.35);
      const blushL = new THREE.Mesh(blushGeo, matBlush);
      blushL.position.set(0.24, -0.07, 0.34);
      blushL.rotation.y = 0.35;
      const blushR = new THREE.Mesh(blushGeo, matBlush);
      blushR.position.set(-0.24, -0.07, 0.34);
      blushR.rotation.y = -0.35;
      headGroup.add(blushL, blushR);

      const noseGeo = new THREE.SphereGeometry(0.052, 24, 20);
      noseGeo.scale(0.88, 1.08, 1.15);
      const noseMesh = new THREE.Mesh(noseGeo, matSkin);
      noseMesh.position.set(0, -0.02, 0.395);
      headGroup.add(noseMesh);

      // Cabello
      const hairGroup = new THREE.Group();
      headGroup.add(hairGroup);

      const hairCrownGeo = new THREE.SphereGeometry(0.455, 36, 28);
      hairCrownGeo.scale(1.06, 1.02, 1.04);
      const hairCrown = new THREE.Mesh(hairCrownGeo, matHair);
      hairCrown.position.set(0, 0.05, -0.03);
      hairGroup.add(hairCrown);

      const bangsCurve = new THREE.CatmullRomCurve3([
        new THREE.Vector3(-0.36, 0.14, 0.25),
        new THREE.Vector3(-0.12, 0.19, 0.38),
        new THREE.Vector3(0.14, 0.24, 0.37),
        new THREE.Vector3(0.35, 0.18, 0.24)
      ]);
      const bangsGeo = new THREE.TubeGeometry(bangsCurve, 28, 0.12, 16, false);
      bangsGeo.scale(1.0, 0.85, 0.72);
      hairGroup.add(new THREE.Mesh(bangsGeo, matHair));

      function createHairLock(side) {
        const curve = new THREE.CatmullRomCurve3([
          new THREE.Vector3(side * 0.30, 0.26, 0.14),
          new THREE.Vector3(side * 0.43, 0.02, 0.12),
          new THREE.Vector3(side * 0.44, -0.26, 0.10),
          new THREE.Vector3(side * 0.39, -0.46, 0.12)
        ]);
        const lockGeo = new THREE.TubeGeometry(curve, 24, 0.125, 16, false);
        lockGeo.scale(0.82, 1.0, 1.15);
        const lockMesh = new THREE.Mesh(lockGeo, matHair);
        const tipCap = new THREE.Mesh(new THREE.SphereGeometry(0.10, 16, 16), matHair);
        tipCap.position.set(side * 0.39, -0.46, 0.12);
        tipCap.scale.set(0.85, 0.9, 1.1);
        const g = new THREE.Group();
        g.add(lockMesh, tipCap);
        return g;
      }
      hairGroup.add(createHairLock(-1), createHairLock(1));

      function createSculptedEye(xPos) {
        const eyeAnchor = new THREE.Group();
        eyeAnchor.position.set(xPos, 0.02, 0.375);

        const openEyeGroup = new THREE.Group();
        eyeAnchor.add(openEyeGroup);

        const darkEyeGeo = new THREE.SphereGeometry(0.046, 24, 20);
        darkEyeGeo.scale(0.92, 1.08, 0.55);
        openEyeGroup.add(new THREE.Mesh(darkEyeGeo, matEyeDark));

        const highlight = new THREE.Mesh(new THREE.SphereGeometry(0.013, 12, 12), matEyeHighlight);
        highlight.position.set(-0.014, 0.016, 0.024);
        openEyeGroup.add(highlight);

        const upperLidGeo = new THREE.SphereGeometry(0.054, 24, 16);
        upperLidGeo.scale(1.15, 0.45, 0.65);
        const upperLid = new THREE.Mesh(upperLidGeo, matSkin);
        upperLid.position.set(0, 0.055, 0.01);
        eyeAnchor.add(upperLid);

        const closedCurve = new THREE.CatmullRomCurve3([
          new THREE.Vector3(-0.052, 0.0, 0.018),
          new THREE.Vector3(0.0, -0.014, 0.024),
          new THREE.Vector3(0.052, 0.0, 0.018)
        ]);
        const closedLash = new THREE.Mesh(new THREE.TubeGeometry(closedCurve, 16, 0.009, 10, false), matMouth);
        closedLash.visible = false;
        eyeAnchor.add(closedLash);

        return { eyeAnchor, openEyeGroup, upperLid, closedLash };
      }

      const rightEye = createSculptedEye(-0.155);
      const leftEye  = createSculptedEye(0.155);
      headGroup.add(rightEye.eyeAnchor, leftEye.eyeAnchor);

      function createSculptedBrow(side) {
        const curve = new THREE.CatmullRomCurve3([
          new THREE.Vector3(side * 0.08, 0.125, 0.37),
          new THREE.Vector3(side * 0.155, 0.142, 0.38),
          new THREE.Vector3(side * 0.225, 0.125, 0.36)
        ]);
        return new THREE.Mesh(new THREE.TubeGeometry(curve, 16, 0.018, 12, false), matHair);
      }
      const browR = createSculptedBrow(-1);
      const browL = createSculptedBrow(1);
      headGroup.add(browR, browL);

      const mouthGroup = new THREE.Group();
      mouthGroup.position.set(0, -0.145, 0.375);
      headGroup.add(mouthGroup);

      const smileCurve = new THREE.CatmullRomCurve3([
        new THREE.Vector3(-0.065, 0.012, 0),
        new THREE.Vector3(0, -0.015, 0.012),
        new THREE.Vector3(0.065, 0.012, 0)
      ]);
      mouthGroup.add(new THREE.Mesh(new THREE.TubeGeometry(smileCurve, 20, 0.012, 10, false), matMouth));

      const iotTube = new THREE.Mesh(
        new THREE.CylinderGeometry(0.022, 0.022, 0.28, 16),
        new THREE.MeshPhysicalMaterial({ color: 0x93C5FD, roughness: 0.2, transparent: true, opacity: 0.85 })
      );
      iotTube.position.set(0.02, -0.18, 0.46);
      iotTube.rotation.x = Math.PI * 0.38;
      iotTube.visible = false;
      headGroup.add(iotTube);

      function createRealHand3D(side) {
        const wristGroup = new THREE.Group();
        const palmMesh = new THREE.Mesh(new THREE.BoxGeometry(0.15, 0.16, 0.065), matSkin);
        palmMesh.position.y = -0.075;
        wristGroup.add(palmMesh);

        const fingerSpecs = [
          { x: -side * 0.054, len1: 0.068, len2: 0.055, r: 0.017 },
          { x: -side * 0.018, len1: 0.076, len2: 0.060, r: 0.018 },
          { x:  side * 0.018, len1: 0.070, len2: 0.056, r: 0.017 },
          { x:  side * 0.052, len1: 0.056, len2: 0.046, r: 0.015 }
        ];

        const fingerJoints = [];
        fingerSpecs.forEach((spec) => {
          const proxPivot = new THREE.Group();
          proxPivot.position.set(spec.x, -0.155, 0);
          wristGroup.add(proxPivot);

          const phalanx1 = createSmoothCapsule(spec.r, spec.r * 0.92, spec.len1, matSkin, 14);
          phalanx1.position.y = -spec.len1 / 2;
          proxPivot.add(phalanx1);

          const distPivot = new THREE.Group();
          distPivot.position.y = -spec.len1;
          proxPivot.add(distPivot);

          const phalanx2 = createSmoothCapsule(spec.r * 0.92, spec.r * 0.80, spec.len2, matSkin, 14);
          phalanx2.position.y = -spec.len2 / 2;
          distPivot.add(phalanx2);

          const nail = new THREE.Mesh(new THREE.SphereGeometry(spec.r * 0.72, 10, 10), matNails);
          nail.scale.set(0.85, 1.1, 0.35);
          nail.position.set(0, -spec.len2 * 0.78, spec.r * 0.72);
          distPivot.add(nail);

          fingerJoints.push({ proxPivot, distPivot });
        });

        const thumbPivot = new THREE.Group();
        thumbPivot.position.set(-side * 0.072, -0.065, 0.015);
        thumbPivot.rotation.z = -side * 0.58;
        wristGroup.add(thumbPivot);

        const thumbPhalanx1 = createSmoothCapsule(0.021, 0.018, 0.065, matSkin, 14);
        thumbPhalanx1.position.y = -0.032;
        thumbPivot.add(thumbPhalanx1);

        const thumbDistPivot = new THREE.Group();
        thumbDistPivot.position.y = -0.065;
        thumbPivot.add(thumbDistPivot);

        const thumbPhalanx2 = createSmoothCapsule(0.018, 0.015, 0.052, matSkin, 14);
        thumbPhalanx2.position.y = -0.026;
        thumbDistPivot.add(thumbPhalanx2);

        return { wristGroup, fingerJoints, thumbPivot, thumbDistPivot };
      }

      function createSculptedArm(side) {
        const shoulderPivot = new THREE.Group();
        shoulderPivot.position.set(side * 0.56, 0.42, 0.02);
        torsoGroup.add(shoulderPivot);

        const sleeve = createSmoothCapsule(0.145, 0.13, 0.28, matShirt, 24);
        sleeve.position.y = -0.12;
        shoulderPivot.add(sleeve);

        const upperArm = createSmoothCapsule(0.112, 0.098, 0.38, matSkin, 24);
        upperArm.position.y = -0.34;
        shoulderPivot.add(upperArm);

        const elbowPivot = new THREE.Group();
        elbowPivot.position.y = -0.54;
        shoulderPivot.add(elbowPivot);

        const forearm = createSmoothCapsule(0.096, 0.074, 0.50, matSkin, 24);
        forearm.position.y = -0.25;
        elbowPivot.add(forearm);

        const hand = createRealHand3D(side);
        hand.wristGroup.position.y = -0.51;
        elbowPivot.add(hand.wristGroup);

        return { shoulderPivot, elbowPivot, hand };
      }

      const rightArm = createSculptedArm(-1);
      const leftArm  = createSculptedArm(1);

      const doctorGroup = new THREE.Group();
      doctorGroup.position.set(2.2, -0.9, 1.4);
      scene.add(doctorGroup);

      const docForearm = createSmoothCapsule(0.115, 0.095, 0.65, matDocSleeve, 20);
      docForearm.rotation.z = Math.PI * 0.38;
      docForearm.position.set(0.36, -0.18, 0);
      doctorGroup.add(docForearm);

      const docHand = createRealHand3D(-1);
      docHand.wristGroup.rotation.z = Math.PI * 0.38;
      docHand.wristGroup.rotation.y = -0.4;
      docHand.fingerJoints.forEach(fj => {
        fj.proxPivot.rotation.x = 0.85;
        fj.distPivot.rotation.x = 0.75;
      });
      doctorGroup.add(docHand.wristGroup);

      const penGroup = new THREE.Group();
      penGroup.position.set(-0.18, 0.06, 0.04);
      penGroup.rotation.z = Math.PI * 0.43;
      const penBarrel = new THREE.Mesh(new THREE.CylinderGeometry(0.018, 0.016, 0.42, 16), matPenBody);
      const penCone = new THREE.Mesh(new THREE.ConeGeometry(0.016, 0.06, 16), matPenTip);
      penCone.position.y = 0.24;
      penGroup.add(penBarrel, penCone);
      doctorGroup.add(penGroup);

      const targetPose = {
        headRotX: 0, headRotY: 0, headRotZ: 0,
        eyeOpenness: 1.0,
        browTilt: 0,
        mouthScaleY: 1.0,
        mouthRotX: 0,
        rShoulder: { x: -1.15, y: 0.2, z: -0.45 },
        rElbow:    { x: -1.1, y: 0, z: 0 },
        rWrist:    { x: 0, y: 0.2, z: 0 },
        rCurl:     0.12,
        lShoulder: { x: -0.35, y: -0.2, z: 0.18 },
        lElbow:    { x: -0.85, y: 0.2, z: -0.25 },
        lWrist:    { x: 0, y: -0.2, z: 0 },
        lCurl:     0.22,
        docPos:    { x: 2.3, y: -0.9, z: 1.4 }
      };

      let camTarget = new THREE.Vector3(0, 0.52, 0);
      let camSpherical = { radius: 4.15, theta: 0, phi: 1.42 };
      let targetCamSpherical = { radius: 4.15, theta: 0, phi: 1.42 };
      let targetCamLook = new THREE.Vector3(0, 0.52, 0);

      let isOrbiting = false;
      let prevMouse = { x: 0, y: 0 };

      container.addEventListener('pointerdown', (e) => {
        if (e.target.tagName === 'BUTTON') return;
        isOrbiting = true;
        prevMouse = { x: e.clientX, y: e.clientY };
      });
      window.addEventListener('pointermove', (e) => {
        if (!isOrbiting) return;
        const dx = (e.clientX - prevMouse.x) * 0.007;
        const dy = (e.clientY - prevMouse.y) * 0.007;
        targetCamSpherical.theta = Math.max(-0.9, Math.min(0.9, targetCamSpherical.theta - dx));
        targetCamSpherical.phi = Math.max(0.9, Math.min(1.65, targetCamSpherical.phi - dy));
        prevMouse = { x: e.clientX, y: e.clientY };
      });
      window.addEventListener('pointerup', () => { isOrbiting = false; });

      document.getElementById('cam-general').addEventListener('click', () => {
        targetCamSpherical = { radius: 4.15, theta: 0, phi: 1.42 };
        targetCamLook.set(0, 0.52, 0);
      });
      document.getElementById('cam-rostro').addEventListener('click', () => {
        targetCamSpherical = { radius: 2.05, theta: 0, phi: 1.44 };
        targetCamLook.set(0, 1.18, 0.15);
      });
      document.getElementById('cam-dolor').addEventListener('click', () => {
        targetCamSpherical = { radius: 2.85, theta: 0.28, phi: 1.35 };
        targetCamLook.set(0.32, -0.05, 0.35);
      });

      function calcularPostura3D(E, V, M) {
        const total = E + V + M;

        if (E === 4) { targetPose.eyeOpenness = 1.0; targetPose.browTilt = 0.0; }
        else if (E === 3) { targetPose.eyeOpenness = 0.52; targetPose.browTilt = 0.08; }
        else if (E === 2) { targetPose.eyeOpenness = 0.22; targetPose.browTilt = -0.26; }
        else { targetPose.eyeOpenness = 0.0; targetPose.browTilt = 0.0; }

        iotTube.visible = (total <= 8 && V === 1);
        if (V === 5) { targetPose.mouthScaleY = 1.0; targetPose.mouthRotX = 0; }
        else if (V === 4 || V === 3) { targetPose.mouthScaleY = 1.6; targetPose.mouthRotX = 0.3; }
        else if (V === 2) { targetPose.mouthScaleY = 1.9; targetPose.mouthRotX = 0.8; }
        else { targetPose.mouthScaleY = 0.35; targetPose.mouthRotX = 0; }

        if (M === 6) {
          targetPose.rShoulder = { x: -1.25, y: 0.15, z: -0.42 };
          targetPose.rElbow    = { x: -1.15, y: 0, z: 0 };
          targetPose.rWrist    = { x: 0.15, y: 0.3, z: 0 };
          targetPose.rCurl     = 0.08;
          targetPose.lShoulder = { x: -0.38, y: -0.2, z: 0.16 };
          targetPose.lElbow    = { x: -0.85, y: 0, z: -0.28 };
          targetPose.lWrist    = { x: 0, y: -0.2, z: 0 };
          targetPose.lCurl     = 0.25;
          targetPose.headRotX = 0; targetPose.headRotZ = 0;
        } else if (M === 5) {
          targetPose.rShoulder = { x: -0.78, y: 0.62, z: 0.52 };
          targetPose.rElbow    = { x: -1.42, y: 0, z: 0.38 };
          targetPose.rWrist    = { x: 0.1, y: 0, z: 0 };
          targetPose.rCurl     = 0.35;
          targetPose.lShoulder = { x: -0.42, y: -0.12, z: 0.15 };
          targetPose.lElbow    = { x: -0.78, y: 0, z: -0.2 };
          targetPose.lWrist    = { x: 0, y: 0, z: 0 };
          targetPose.lCurl     = 0.28;
          targetPose.headRotX = 0.06; targetPose.headRotZ = -0.06;
        } else if (M === 4) {
          targetPose.rShoulder = { x: -0.42, y: 0.1, z: -0.15 };
          targetPose.rElbow    = { x: -0.82, y: 0, z: 0.2 };
          targetPose.rWrist    = { x: 0, y: 0, z: 0 };
          targetPose.rCurl     = 0.3;
          targetPose.lShoulder = { x: -0.85, y: -0.32, z: 0.42 };
          targetPose.lElbow    = { x: -1.32, y: 0, z: -0.25 };
          targetPose.lWrist    = { x: -0.25, y: 0, z: 0 };
          targetPose.lCurl     = 0.45;
          targetPose.headRotX = 0.04; targetPose.headRotZ = 0.07;
        } else if (M === 3) {
          targetPose.rShoulder = { x: -0.58, y: 0.48, z: 0.36 };
          targetPose.rElbow    = { x: -2.02, y: 0, z: 0.35 };
          targetPose.rWrist    = { x: 0.85, y: 0.4, z: 0 };
          targetPose.rCurl     = 1.38;
          targetPose.lShoulder = { x: -0.58, y: -0.48, z: -0.36 };
          targetPose.lElbow    = { x: -2.02, y: 0, z: -0.35 };
          targetPose.lWrist    = { x: 0.85, y: -0.4, z: 0 };
          targetPose.lCurl     = 1.38;
          targetPose.headRotX = -0.10; targetPose.headRotZ = 0;
        } else if (M === 2) {
          targetPose.rShoulder = { x: -0.15, y: -0.85, z: -0.14 };
          targetPose.rElbow    = { x: -0.12, y: 0, z: 0 };
          targetPose.rWrist    = { x: -0.65, y: 0.85, z: -0.45 };
          targetPose.rCurl     = 1.35;
          targetPose.lShoulder = { x: -0.15, y: 0.85, z: 0.14 };
          targetPose.lElbow    = { x: -0.12, y: 0, z: 0 };
          targetPose.lWrist    = { x: -0.65, y: -0.85, z: 0.45 };
          targetPose.lCurl     = 1.35;
          targetPose.headRotX = -0.18; targetPose.headRotZ = 0;
        } else {
          targetPose.rShoulder = { x: 0.04, y: 0, z: -0.20 };
          targetPose.rElbow    = { x: -0.15, y: 0, z: 0 };
          targetPose.rWrist    = { x: 0.08, y: 0, z: 0 };
          targetPose.rCurl     = 0.32;
          targetPose.lShoulder = { x: 0.04, y: 0, z: 0.20 };
          targetPose.lElbow    = { x: -0.15, y: 0, z: 0 };
          targetPose.lWrist    = { x: 0.08, y: 0, z: 0 };
          targetPose.lCurl     = 0.32;
          targetPose.headRotX = 0.14; targetPose.headRotZ = 0.18;
        }

        if (E === 2 || (M <= 5 && M >= 2)) {
          targetPose.docPos = { x: 0.78, y: -0.26, z: 0.58 };
        } else {
          targetPose.docPos = { x: 2.3, y: -0.9, z: 1.4 };
        }
      }

      const clock = new THREE.Clock();
      let currentOpenness = 1.0;
      let currentRCurl = 0.12;
      let currentLCurl = 0.22;

      function animateHandFingers(handObj, curlAmount) {
        handObj.fingerJoints.forEach((fj) => {
          fj.proxPivot.rotation.x = curlAmount;
          fj.distPivot.rotation.x = curlAmount * 1.1;
        });
        handObj.thumbDistPivot.rotation.x = curlAmount * 0.85;
      }

      function animate3D() {
        requestAnimationFrame(animate3D);
        const t = clock.getElapsedTime();
        const lerpSpeed = 0.09;

        const respRate = (state.E + state.V + state.M <= 8) ? 1.3 : 2.3;
        torsoGroup.position.y = Math.sin(t * respRate) * 0.015;
        torsoMesh.scale.z = 0.72 + Math.sin(t * respRate) * 0.02;

        let blinkFactor = 1.0;
        if (state.E === 4 && Math.sin(t * 1.7) > 0.965) blinkFactor = 0.0;

        const desiredOpen = targetPose.eyeOpenness * blinkFactor;
        currentOpenness = THREE.MathUtils.lerp(currentOpenness, desiredOpen, 0.22);

        [rightEye, leftEye].forEach((eye) => {
          if (currentOpenness < 0.12) {
            eye.openEyeGroup.visible = false;
            eye.upperLid.visible = false;
            eye.closedLash.visible = true;
          } else {
            eye.openEyeGroup.visible = true;
            eye.upperLid.visible = true;
            eye.closedLash.visible = false;
            eye.openEyeGroup.scale.y = Math.max(0.2, currentOpenness);
            eye.upperLid.position.y = 0.015 + currentOpenness * 0.042;
          }
        });

        browR.rotation.z = THREE.MathUtils.lerp(browR.rotation.z, targetPose.browTilt, lerpSpeed);
        browL.rotation.z = THREE.MathUtils.lerp(browL.rotation.z, -targetPose.browTilt, lerpSpeed);
        mouthGroup.scale.y = THREE.MathUtils.lerp(mouthGroup.scale.y, targetPose.mouthScaleY, lerpSpeed);
        mouthGroup.rotation.x = THREE.MathUtils.lerp(mouthGroup.rotation.x, targetPose.mouthRotX, lerpSpeed);

        const tremor = (state.M === 3 || state.M === 2) ? Math.sin(t * 42) * 0.01 : 0;

        headGroup.rotation.x = THREE.MathUtils.lerp(headGroup.rotation.x, targetPose.headRotX, lerpSpeed);
        headGroup.rotation.z = THREE.MathUtils.lerp(headGroup.rotation.z, targetPose.headRotZ, lerpSpeed);
        headGroup.rotation.y = (state.E === 4) ? Math.sin(t * 0.7) * 0.07 : THREE.MathUtils.lerp(headGroup.rotation.y, 0, lerpSpeed);

        rightArm.shoulderPivot.rotation.x = THREE.MathUtils.lerp(rightArm.shoulderPivot.rotation.x, targetPose.rShoulder.x + tremor, lerpSpeed);
        rightArm.shoulderPivot.rotation.y = THREE.MathUtils.lerp(rightArm.shoulderPivot.rotation.y, targetPose.rShoulder.y, lerpSpeed);
        rightArm.shoulderPivot.rotation.z = THREE.MathUtils.lerp(rightArm.shoulderPivot.rotation.z, targetPose.rShoulder.z, lerpSpeed);
        rightArm.elbowPivot.rotation.x    = THREE.MathUtils.lerp(rightArm.elbowPivot.rotation.x, targetPose.rElbow.x + tremor, lerpSpeed);
        rightArm.elbowPivot.rotation.z    = THREE.MathUtils.lerp(rightArm.elbowPivot.rotation.z, targetPose.rElbow.z, lerpSpeed);
        rightArm.hand.wristGroup.rotation.x = THREE.MathUtils.lerp(rightArm.hand.wristGroup.rotation.x, targetPose.rWrist.x, lerpSpeed);
        rightArm.hand.wristGroup.rotation.y = THREE.MathUtils.lerp(rightArm.hand.wristGroup.rotation.y, targetPose.rWrist.y, lerpSpeed);
        rightArm.hand.wristGroup.rotation.z = (state.M === 6)
          ? Math.sin(t * 4.2) * 0.22
          : THREE.MathUtils.lerp(rightArm.hand.wristGroup.rotation.z, targetPose.rWrist.z, lerpSpeed);

        currentRCurl = THREE.MathUtils.lerp(currentRCurl, targetPose.rCurl, lerpSpeed);
        animateHandFingers(rightArm.hand, currentRCurl);

        leftArm.shoulderPivot.rotation.x = THREE.MathUtils.lerp(leftArm.shoulderPivot.rotation.x, targetPose.lShoulder.x + tremor, lerpSpeed);
        leftArm.shoulderPivot.rotation.y = THREE.MathUtils.lerp(leftArm.shoulderPivot.rotation.y, targetPose.lShoulder.y, lerpSpeed);
        leftArm.shoulderPivot.rotation.z = THREE.MathUtils.lerp(leftArm.shoulderPivot.rotation.z, targetPose.lShoulder.z, lerpSpeed);
        leftArm.elbowPivot.rotation.x    = THREE.MathUtils.lerp(leftArm.elbowPivot.rotation.x, targetPose.lElbow.x + tremor, lerpSpeed);
        leftArm.elbowPivot.rotation.z    = THREE.MathUtils.lerp(leftArm.elbowPivot.rotation.z, targetPose.lElbow.z, lerpSpeed);
        leftArm.hand.wristGroup.rotation.x = THREE.MathUtils.lerp(leftArm.hand.wristGroup.rotation.x, targetPose.lWrist.x, lerpSpeed);
        leftArm.hand.wristGroup.rotation.y = THREE.MathUtils.lerp(leftArm.hand.wristGroup.rotation.y, targetPose.lWrist.y, lerpSpeed);
        leftArm.hand.wristGroup.rotation.z = THREE.MathUtils.lerp(leftArm.hand.wristGroup.rotation.z, targetPose.lWrist.z, lerpSpeed);

        currentLCurl = THREE.MathUtils.lerp(currentLCurl, targetPose.lCurl, lerpSpeed);
        animateHandFingers(leftArm.hand, currentLCurl);

        doctorGroup.position.x = THREE.MathUtils.lerp(doctorGroup.position.x, targetPose.docPos.x, 0.1);
        doctorGroup.position.y = THREE.MathUtils.lerp(doctorGroup.position.y, targetPose.docPos.y + Math.sin(t * 4.5) * 0.015, 0.1);
        doctorGroup.position.z = THREE.MathUtils.lerp(doctorGroup.position.z, targetPose.docPos.z, 0.1);

        camSpherical.radius = THREE.MathUtils.lerp(camSpherical.radius, targetCamSpherical.radius, 0.08);
        camSpherical.theta  = THREE.MathUtils.lerp(camSpherical.theta, targetCamSpherical.theta, 0.08);
        camSpherical.phi    = THREE.MathUtils.lerp(camSpherical.phi, targetCamSpherical.phi, 0.08);
        camTarget.lerp(targetCamLook, 0.08);

        camera.position.x = camTarget.x + camSpherical.radius * Math.sin(camSpherical.phi) * Math.sin(camSpherical.theta);
        camera.position.y = camTarget.y + camSpherical.radius * Math.cos(camSpherical.phi);
        camera.position.z = camTarget.z + camSpherical.radius * Math.sin(camSpherical.phi) * Math.cos(camSpherical.theta);
        camera.lookAt(camTarget);

        renderer.render(scene, camera);
      }
      animate3D();

      window.addEventListener('resize', () => {
        camera.aspect = container.clientWidth / container.clientHeight;
        camera.updateProjectionMatrix();
        renderer.setSize(container.clientWidth, container.clientHeight);
      });

      // ==========================================================
      // 3. ACTUALIZACIÓN DE INTERFAZ Y MOVIMIENTO FLUIDO DE PALANCAS
      // ==========================================================
      function actualizarSimulador(moverPerillas = true) {
        const { E, V, M } = state;
        const total = E + V + M;

        if (moverPerillas) {
          document.getElementById('knob-E').style.top = `${posOcular[E]}%`;
          document.getElementById('knob-V').style.top = `${posVerbal[V]}%`;
          document.getElementById('knob-M').style.top = `${posMotor[M]}%`;
        }

        document.querySelectorAll('.slider-btn').forEach(btn => {
          const g = btn.getAttribute('data-group');
          const v = parseInt(btn.getAttribute('data-val'));
          const colores = { E: '#2563EB', V: '#D97706', M: '#059669' };
          if (state[g] === v) {
            btn.style.backgroundColor = colores[g];
            btn.style.color = '#FFFFFF';
          } else {
            btn.style.backgroundColor = '#FFFFFF';
            btn.style.color = '#2A324B';
          }
        });

        document.getElementById('top-e').textContent = E;
        document.getElementById('top-v').textContent = V;
        document.getElementById('top-m').textContent = M;
        document.getElementById('top-total').textContent = total;
        document.getElementById('pantalla-verde-gcs').textContent = total;
        document.getElementById('subtitulo-resumen').textContent = `OCULAR ${E} · VERBAL ${V} · MOTOR ${M}`;

        const badgeNum = document.getElementById('badge-numero-activo');
        const catActiva = document.getElementById('categoria-activa');
        const titActivo = document.getElementById('titulo-estado-activo');
        const subActivo = document.getElementById('subtitulo-estado-activo');

        if (ultimoModificado === 'E') {
          badgeNum.textContent = E;
          badgeNum.style.backgroundColor = '#2563EB';
          catActiva.textContent = `APERTURA OCULAR (E${E})`;
          catActiva.style.color = '#2563EB';
          titActivo.textContent = infoE[E].tit;
          subActivo.textContent = infoE[E].sub;
        } else if (ultimoModificado === 'V') {
          badgeNum.textContent = V;
          badgeNum.style.backgroundColor = '#D97706';
          catActiva.textContent = `RESPUESTA VERBAL (V${V})`;
          catActiva.style.color = '#D97706';
          titActivo.textContent = infoV[V].tit;
          subActivo.textContent = infoV[V].sub;
        } else {
          badgeNum.textContent = M;
          badgeNum.style.backgroundColor = '#059669';
          catActiva.textContent = `RESPUESTA MOTORA (M${M})`;
          catActiva.style.color = '#059669';
          titActivo.textContent = infoM[M].tit;
          subActivo.textContent = infoM[M].sub;
        }

        document.getElementById('num-v-globo').textContent = V;
        document.getElementById('globo-paciente').textContent = infoV[V].frase;

        const tipSemio = document.getElementById('tip-semiologico');
        if (E === 2 || (M <= 5 && M >= 2)) {
          tipSemio.classList.remove('hidden');
        } else {
          tipSemio.classList.add('hidden');
        }

        const badgeInt = document.getElementById('badge-interpretacion');
        const txtCorr = document.getElementById('texto-correlacion');

        if (total >= 13) {
          badgeInt.textContent = `TCE LEVE / CONSCIENTE (${total}/15 PTS)`;
          badgeInt.className = "font-tecnica text-xs font-extrabold uppercase px-2.5 py-0.5 border border-[#2A324B] bg-emerald-200 text-[#1E2436] inline-block mb-1";
        } else if (total >= 9) {
          badgeInt.textContent = `TCE MODERADO / LETARGIA (${total}/15 PTS)`;
          badgeInt.className = "font-tecnica text-xs font-extrabold uppercase px-2.5 py-0.5 border border-[#2A324B] bg-amber-200 text-[#1E2436] inline-block mb-1";
        } else {
          badgeInt.textContent = `🚨 TCE GRAVE / COMA (${total}/15 PTS) — INTUBACIÓN INDICADA (GCS ≤ 8)`;
          badgeInt.className = "font-tecnica text-xs font-extrabold uppercase px-2.5 py-0.5 border border-[#2A324B] bg-red-600 text-white inline-block mb-1";
        }

        if (M === 3) {
          txtCorr.innerHTML = "<strong>Decorticación (M3):</strong> Lesión supratentorial grave <strong>por encima del Núcleo Rojo</strong>. Flexión rígida sobre el pecho.";
        } else if (M === 2) {
          txtCorr.innerHTML = "<strong>Descerebración (M2):</strong> Lesión crítica de tronco <strong>por debajo del Núcleo Rojo</strong>. Hiperextensión y pronación severa.";
        } else if (total === 3) {
          txtCorr.innerHTML = "<strong>Coma Profundo (3/15):</strong> Abolición completa de respuestas del SRAA y flacidez corticoespinal total.";
        } else {
          txtCorr.innerHTML = `<strong>Estado actual:</strong> Ocular (${infoE[E].tit.toLowerCase()}), Verbal (${infoV[V].tit.toLowerCase()}) y Motor (${infoM[M].tit.toLowerCase()}).`;
        }

        calcularPostura3D(E, V, M);
      }

      // ==========================================================
      // 4. ARRASTRE 100% FLUIDO + SONIDO SUTIL SOLO EN CADA NÚMERO
      // ==========================================================
      let activeDrag = null;

      document.querySelectorAll('.fader-track').forEach(track => {
        const group = track.getAttribute('data-group');
        const maxVal = parseInt(track.getAttribute('data-max'));
        const knob = document.getElementById(`knob-${group}`);

        function procesarMovimientoPalanca(clientY, soltar = false) {
          const rect = track.getBoundingClientRect();
          const pad = 16;
          let y = clientY - rect.top - pad;
          const altoUtil = rect.height - pad * 2;
          let ratio = Math.max(0, Math.min(1, y / altoUtil));

          if (!soltar) {
            // Movimiento 100% fluido siguiendo el cursor sin trabas
            knob.style.top = `${ratio * 84 + 3}%`;
          }

          // Detectar si llegó a un nuevo número
          const valorCalculado = Math.round(maxVal - ratio * (maxVal - 1));
          if (state[group] !== valorCalculado) {
            state[group] = valorCalculado;
            ultimoModificado = group;
            sonarEncajeSuave(valorCalculado); // 🔊 Clic suave solo al colocarse en un número
            actualizarSimulador(false);
          }

          if (soltar) {
            knob.classList.remove('dragging');
            actualizarSimulador(true); // Deslizamiento suave final al número
          }
        }

        track.addEventListener('pointerdown', (e) => {
          desbloquearAudio();
          if (e.target.classList.contains('slider-btn')) return;
          activeDrag = { group, procesarMovimientoPalanca };
          knob.classList.add('dragging');
          track.setPointerCapture(e.pointerId);
          procesarMovimientoPalanca(e.clientY, false);
        });

        track.addEventListener('pointermove', (e) => {
          if (!activeDrag || activeDrag.group !== group) return;
          procesarMovimientoPalanca(e.clientY, false);
        });

        track.addEventListener('pointerup', (e) => {
          if (!activeDrag || activeDrag.group !== group) return;
          procesarMovimientoPalanca(e.clientY, true);
          activeDrag = null;
        });
      });

      document.querySelectorAll('.slider-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          desbloquearAudio();
          const g = btn.getAttribute('data-group');
          const v = parseInt(btn.getAttribute('data-val'));
          if (state[g] !== v) sonarEncajeSuave(v);
          state[g] = v;
          ultimoModificado = g;
          actualizarSimulador(true);
        });
      });

      document.querySelectorAll('.preset-rapido').forEach(btn => {
        btn.addEventListener('click', () => {
          desbloquearAudio();
          const [e, v, m] = btn.getAttribute('data-preset').split(',').map(Number);
          sonarEncajeSuave(m);
          state.E = e; state.V = v; state.M = m;
          ultimoModificado = 'M';
          actualizarSimulador(true);
        });
      });

      actualizarSimulador(true);
    </script>
  </body>
</html>