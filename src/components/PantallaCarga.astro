---
const { subtitulo = "Inicializando módulo interactivo..." } = Astro.props;
---
<div id="neuro-loader" class="pantalla-intro fixed inset-0 z-50 bg-[#0B1D3A] flex flex-col items-center justify-center p-6 border-8 border-[#141413]">
  <div class="logo-animado flex flex-col items-center max-w-md w-full text-center">
    <img 
      src="/logo-neurolab.png" 
      alt="Logo NeuroLab" 
      class="h-28 md:h-36 w-auto object-contain mb-5"
      onerror="this.style.display='none'" 
    />
    <h2 class="font-editorial text-3xl md:text-4xl text-[#FAF8F5] font-bold tracking-wide mb-1">
      NEUROLAB
    </h2>
    <p class="font-tecnica text-[11px] uppercase tracking-[0.25em] text-[#D4AF37] mb-5">
      Laboratorio de Neuroanatomía // UNAH-VS
    </p>
    <div class="w-60 h-[2px] bg-[#FAF8F5]/20 overflow-hidden">
      <div class="progreso-linea h-full bg-[#D4AF37]"></div>
    </div>
    <span class="font-tecnica text-[10px] text-[#FAF8F5]/60 uppercase tracking-widest mt-3">
      {subtitulo}
    </span>
  </div>
</div>

<style>
  @keyframes barraCarga {
    0% { width: 0%; }
    100% { width: 100%; }
  }
  @keyframes desvanecerIntro {
    0%, 72% { opacity: 1; visibility: visible; }
    100% { opacity: 0; visibility: hidden; pointer-events: none; }
  }
  @keyframes pulsoLogo {
    0% { transform: scale(0.95); opacity: 0; }
    40% { transform: scale(1); opacity: 1; }
    100% { transform: scale(1); opacity: 1; }
  }
  .pantalla-intro {
    animation: desvanecerIntro 1.5s cubic-bezier(0.77, 0, 0.175, 1) forwards;
  }
  .logo-animado {
    animation: pulsoLogo 1.1s ease-out forwards;
  }
  .progreso-linea {
    animation: barraCarga 1.1s ease-in-out forwards;
  }
</style>