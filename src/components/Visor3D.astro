---
const { urlSketchfab, titulo } = Astro.props;
---
<div class="w-full max-w-4xl mx-auto aspect-video rounded-xl overflow-hidden shadow-lg border border-gray-300" style="width: 100%; max-width: 900px; height: 500px; margin: 0 auto;">
  <iframe 
    title={titulo} 
    class="w-full h-full bg-slate-200"
    style="width: 100%; height: 100%; border: none;"
    src={urlSketchfab} 
    allow="autoplay; fullscreen; xr-spatial-tracking" 
    execution-while-out-of-viewport 
    execution-while-not-rendered>
  </iframe>
</div>