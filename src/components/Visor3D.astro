---
const { urlSketchfab, titulo, codigoLamina = "FIG. 01" } = Astro.props;
---
<figure class="w-full border border-[#141413] bg-[#141413]">
  <!-- Barra superior técnica del visor -->
  <div class="flex justify-between items-center px-4 py-2 bg-[#FAF8F5] border-b border-[#141413] font-mono text-xs uppercase tracking-widest text-[#141413]">
    <span>[{codigoLamina}] — {titulo}</span>
    <span class="text-[#B8860B] font-semibold">MODELO INTERACTIVO 3D // ROTE CON EL CURSOR</span>
  </div>
  
  <!-- Contenedor del iframe en ángulo recto -->
  <div style="width: 100%; height: 540px;">
    <iframe 
      title={titulo} 
      style="width: 100%; height: 100%; border: none;"
      src={urlSketchfab} 
      allow="autoplay; fullscreen; xr-spatial-tracking" 
      execution-while-out-of-viewport 
      execution-while-not-rendered>
    </iframe>
  </div>
</figure>